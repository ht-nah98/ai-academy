{
  "name": "teampulse-n15",
  "private": true,
  "type": "module",
  "description": "TeamPulse (app N11–N14: REST + PostgreSQL + WebSocket đồng bộ + đăng nhập) — bài N15: test tích hợp + Docker Compose",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.ts",
    "migrate": "node migrate-cli.ts",
    "demo": "node demo.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:mine": "node --test --test-force-exit integration.test.ts",
    "test": "node --test --test-force-exit \"../../curriculum/N15-test-tich-hop-docker/tests/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "express": "5.3.0",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
