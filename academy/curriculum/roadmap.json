  "projects": [
    {
      "id": "P0",
      "title": "Khởi động Python",
      "goal": "Viết và test được code Python xử lý dữ liệu, gọi được HTTP API — nền cho mọi bài sau.",
      "track": "AI×Data",
      "lessons": [
        {
          "id": "L01-python-co-ban",
          "title": "Python cơ bản qua dữ liệu tuyển dụng",
          "goal": "Viết 4 hàm Python lọc, đếm, tính trung bình trên danh sách tin tuyển dụng và qua hết test.",
          "status": "ready"
        },
        {
          "id": "L02-http-json-venv-env",
          "title": "HTTP, JSON, venv, .env — gọi API NVIDIA",
          "goal": "Tạo venv, đọc .env, lấy danh sách model từ API NVIDIA và nhóm theo nhà cung cấp, qua hết test offline.",
          "status": "ready"
        }
      ]
    },
    {
      "id": "P1",
      "title": "Chatbot đầu tiên",
      "goal": "Chatbot hỏi đáp về thị trường việc làm IT, chạy trên web, chịu được lỗi và rate limit.",
      "track": "AI",
      "lessons": [
        {
          "id": "L03-goi-llm-dau-tien",
          "title": "Gọi LLM đầu tiên",
          "goal": "Viết hàm ask() gửi câu hỏi tới LLM và trả về câu trả lời + số token đã dùng, qua hết test với fake client.",
          "status": "ready"
        },
        {
          "id": "L04-temperature-system-prompt",
          "title": "Temperature & system prompt",
          "goal": "Cấu hình system prompt và temperature để chatbot trả lời nhất quán, đo được độ ổn định qua 5 lần gọi.",
          "status": "ready"
        },
        {
          "id": "L05-hoi-thoai-context-window",
          "title": "Hội thoại nhiều lượt & context window",
          "goal": "Giữ lịch sử hội thoại và tự cắt bớt khi vượt ngân sách token cho trước.",
          "status": "ready"
        },
        {
          "id": "L06-web-chat-streaming-rate-limit",
          "title": "Web chat, streaming, lỗi & rate limit",
          "goal": "Làm trang chat stream từng token và tự retry có backoff khi gặp lỗi 429.",
          "status": "ready"
        }
      ]
    },
    {
      "id": "P2",
      "title": "Data pipeline tin tuyển dụng",
      "goal": "Pipeline biến tin tuyển dụng thô thành bảng SQLite sạch, chạy lại bao nhiêu lần cũng ra cùng kết quả.",
      "track": "Data",
      "lessons": [
        {
          "id": "L07-du-lieu-ban-pandas",
          "title": "Dữ liệu bẩn & pandas",
          "goal": "Làm sạch bộ tin tuyển dụng thô bằng pandas: chuẩn hóa thành phố, lương, kỹ năng, loại bản trùng.",
          "status": "ready"
        },
        {
          "id": "L08-mo-hinh-hoa-sqlite",
          "title": "Mô hình hóa & nạp SQLite",
          "goal": "Thiết kế schema 3 bảng (jobs, companies, job_skills) và nạp dữ liệu sạch vào SQLite.",
          "status": "ready"
        },
        {
          "id": "L09-sql-phan-tich",
          "title": "SQL phân tích",
          "goal": "Viết 8 truy vấn phân tích dùng JOIN, GROUP BY và window function trả lời câu hỏi thị trường.",
          "status": "ready"
        },
        {
          "id": "L10-etl-chat-luong-du-lieu",
          "title": "ETL lặp lại được & chất lượng dữ liệu",
          "goal": "Đóng gói ETL idempotent kèm bộ kiểm tra chất lượng dữ liệu chặn bản ghi lỗi.",
          "status": "ready"
        }
      ]
    },
    {
      "id": "P3",
      "title": "LLM trích xuất có cấu trúc",
      "goal": "Dùng LLM trích kỹ năng, cấp bậc, lương từ mô tả công việc thành JSON có kiểm định, đo được độ chính xác.",
      "track": "AI×Data",
      "lessons": [
        {
          "id": "L11-structured-output",
          "title": "Structured output & validate",
          "goal": "Trích JSON đúng schema từ mô tả công việc và tự sửa/loại output sai định dạng.",
          "status": "planned"
        },
        {
          "id": "L12-batch-rate-limit-cache",
          "title": "Batch: rate limit, cache, retry, chi phí",
          "goal": "Chạy trích xuất cho 500 tin với cache đĩa, giới hạn RPM, retry và báo cáo chi phí token.",
          "status": "planned"
        },
        {
          "id": "L13-danh-gia-precision-recall",
          "title": "Đánh giá: tập nhãn, precision/recall",
          "goal": "Gán nhãn 30 tin và tính precision/recall/F1 cho việc trích kỹ năng.",
          "status": "planned"
        }
      ]
    },
    {
      "id": "P4",
      "title": "Tìm kiếm ngữ nghĩa & RAG",
      "goal": "Hỏi đáp về tin tuyển dụng có trích nguồn, đo được chất lượng truy hồi.",
      "track": "AI",
      "lessons": [
        {
          "id": "L14-embedding-cosine",
          "title": "Embedding & cosine",
          "goal": "Tìm 5 tin tuyển dụng gần nghĩa nhất với một câu truy vấn bằng embedding và cosine similarity.",
          "status": "planned"
        },
        {
          "id": "L15-chunking-vector-index",
          "title": "Chunking & vector index",
          "goal": "Chia mô tả dài thành chunk, xây vector index lưu đĩa và truy vấn dưới 100 ms.",
          "status": "planned"
        },
        {
          "id": "L16-rag-trich-nguon",
          "title": "RAG có trích nguồn",
          "goal": "Trả lời câu hỏi chỉ dựa trên chunk truy hồi được, mỗi ý kèm id nguồn.",
          "status": "planned"
        },
        {
          "id": "L17-danh-gia-rag",
          "title": "Đánh giá RAG",
          "goal": "Đo recall@k của retrieval và tỉ lệ câu trả lời có căn cứ trên bộ 20 câu hỏi.",
          "status": "planned"
        }
      ]
    },
    {
      "id": "P5",
      "title": "Agent dùng công cụ",
      "goal": "Agent trả lời câu hỏi bằng cách tự gọi công cụ và truy vấn SQL an toàn.",
      "track": "AI",
      "lessons": [
        {
          "id": "L18-function-calling",
          "title": "Function calling",
          "goal": "Cho LLM gọi 2 công cụ Python (tìm tin, thống kê lương) và ghép kết quả thành câu trả lời.",
          "status": "planned"
        },
        {
          "id": "L19-agent-text-to-sql",
          "title": "Agent text-to-SQL an toàn",
          "goal": "Agent sinh SQL chỉ-đọc, chặn câu lệnh nguy hiểm, trả lời đúng ≥ 8/10 câu hỏi mẫu.",
          "status": "planned"
        }
      ]
    },
    {
